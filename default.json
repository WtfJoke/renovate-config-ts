{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":pinAllExceptPeerDependencies", "schedule:earlyMondays", "customManagers:biomeVersions"],
  "updateNotScheduled": true,
  "lockFileMaintenance": {
    "enabled": true,
    "commitMessageAction": "Update lock files"
  },
  "minimumReleaseAge": "14 days",
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true,
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "@aws-sdk",
        "@aws-cdk",
        "aws-sdk-js-v3",
        "aws-cdk",
        "aws-cdk-lib",
        "constructs"
      ],
      "schedule": ["monthly"]
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true,
      "schedule": ["monthly"],
      "minimumReleaseAge": null
    }
  ],
  "timezone": "Europe/Berlin"
}
